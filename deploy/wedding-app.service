# Jednostka systemd - trzyma aplikację uruchomioną w tle, restartuje ją po
# awarii i po restarcie serwera. Skopiuj na serwer do
# /etc/systemd/system/wedding-app.service (jako root), podmieniając ścieżki
# i użytkownika na te faktycznie użyte - patrz deploy/DEPLOY.md.
#
# Instalacja:
#   sudo cp deploy/wedding-app.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wedding-app
#
# Podgląd logów: sudo journalctl -u wedding-app -f

[Unit]
Description=Wedding App (Next.js)
After=network.target

[Service]
Type=simple
# Dedykowany, NIE-rootowy użytkownik - patrz "Użytkownik systemowy" w
# deploy/DEPLOY.md. Aplikacja nie potrzebuje uprawnień roota do niczego.
User=wedding
Group=wedding
WorkingDirectory=/srv/wedding-app
# CELOWO NIE ".env" - Next.js SAM WCZYTUJE .env/.env.local/.env.production
# z katalogu roboczego (patrz node_modules/@next/env) i przepuszcza KAŻDĄ
# wartość przez dotenv-expand (interpolacja $ZMIENNA). Sekrety zawierające
# dosłowny znak "$" po którym idą znaki słowa - a hash bcrypt (np.
# PLATFORM_ADMIN_PASSWORD_HASH, patrz README "Płatności") ZAWSZE tak
# wygląda ("$2b$12$...") - zostają przez to PRZYCIĘTE: dotenv-expand próbuje
# potraktować "$2b", "$12" itd. jako odwołania do (nieistniejących) zmiennych
# i zamienia je na puste stringi. systemd sam w sobie wczytuje tę wartość
# poprawnie (EnvironmentFile NIE robi ekspansji $) - błąd pojawia się
# DOPIERO gdy Next.js wczytuje TEN SAM plik drugi raz pod nazwą ".env".
# Rozwiązanie: plik z sekretami dla systemd ma inną nazwę niż jakikolwiek
# wzorzec, którego szuka Next.js, więc Next.js go po prostu nie znajduje
# i nie dotyka. Złapane empirycznie przy wdrażaniu płatności (super-admin
# nie mógł się zalogować mimo poprawnego hasła) - patrz git log.
EnvironmentFile=/srv/wedding-app/env.systemd-only
# -H 127.0.0.1 - Next.js słucha WYŁĄCZNIE na localhost, nie jest wystawiony
# bezpośrednio do internetu (to robi nginx jako reverse proxy, patrz
# deploy/nginx.conf) - dodatkowa warstwa, nie trzeba ufać samemu Next.js
# w kwestii np. limitów requestów.
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5

# Utwardzenie procesu (RODO art. 32 - "bezpieczeństwo przetwarzania" to
# też ograniczenie tego, co proces MOŻE zrobić, nie tylko szyfrowanie) -
# katalog data/ (baza SQLite + zdjęcia gości) musi zostać zapisywalny,
# reszta systemu plików jest dla tego procesu tylko do odczytu.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/wedding-app/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
